{
  "name": "auth-server",
  "version": "0.1.0",
  "description": "Doughmination single sign-on: an OpenID Connect provider with passkeys, passwords and TOTP, running on Cloudflare Workers + D1.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "vite build",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply auth-server --local",
    "db:migrate:remote": "wrangler d1 migrations apply auth-server --remote",
    "cf-typegen": "wrangler types --env-interface Env",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit && svelte-check --tsgo --tsconfig ./web/tsconfig.json"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.2",
    "hono": "^4.13.8",
    "iconsax": "^0.1.1",
    "jose": "^6.2.12",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@typescript/native": "npm:typescript@7",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6",
    "vite": "^8.3.5",
    "wrangler": "^4.132.0"
  }
}
